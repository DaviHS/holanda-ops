# Copie para .env e preencha. O .env nunca vai para o git.

# PostgreSQL (Neon: use a string de conexão com sslmode=verify-full)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=verify-full"

# Segredo das sessões. Gere com: npx auth secret
AUTH_SECRET=""

# Endereço público do sistema (links dos e-mails)
NEXT_PUBLIC_APP_URL="http://127.0.0.1:2000"

# E-mails (Resend) - opcionais em desenvolvimento
RESEND_API_KEY=""
EMAIL_FROM=""

# Fotos dos funcionários (UploadThing: uploadthing.com > seu app > API Keys)
UPLOADTHING_TOKEN=""
